{
  "expo": {
    "name": "Yumak Pop (Lab)",
    "slug": "yumak-pop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF6EA",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.floppatech.yumakpop",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.floppatech.yumakpop",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#FCE3D3",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFF6EA"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9426623468970945~7281224562",
          "iosAppId": "ca-app-pub-9426623468970945~7281224562"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "extraProguardRules": "-keep class androidx.work.impl.WorkDatabase* { *; }\n-keep class * extends androidx.room.RoomDatabase { *; }\n-keep class androidx.work.** { *; }\n-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod\n-dontwarn androidx.work.impl.**"
          }
        }
      ]
    ],
    "react-native-google-mobile-ads": {
      "android_app_id": "ca-app-pub-9426623468970945~7281224562",
      "ios_app_id": "ca-app-pub-9426623468970945~7281224562"
    },
    "extra": {
      "eas": {
        "projectId": "1e65d64a-65bb-48ac-8750-59f1e089f83b"
      }
    },
    "owner": "floppachesscorp"
  }
}